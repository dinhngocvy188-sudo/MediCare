<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Cap quyen Internet cho Firebase -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MediCare">

        <activity
            android:name="ui.admin.AdminDataActivity"
            android:exported="false" />

        <!-- Man hinh dang ky -->
        <activity
            android:name="ui.auth.RegisterActivity"
            android:exported="false" />

        <!-- Man hinh chinh -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="ui.admin.DoctorVerificationActivity"
            android:exported="false" />
        <!-- Man hinh dang nhap -->
        <activity
            android:name="ui.auth.LoginActivity"
            android:exported="false" />

        <!-- Man hinh quan tri -->
        <activity
            android:name="ui.admin.AdminDashboardActivity"
            android:exported="false" />

        <!-- Man hinh bac si -->
        <activity
            android:name="ui.doctor.DoctorDashboardActivity"
            android:exported="false" />

        <!-- Man hinh benh nhan -->
        <activity
            android:name="ui.patient.PatientHomeActivity"
            android:exported="false" />

        <!-- Man hinh dat lich kham -->
        <activity
            android:name="ui.patient.BookingActivity"
            android:exported="false" />

        <!-- Man hinh lich kham cua toi -->
        <activity
            android:name="ui.patient.PatientAppointmentsActivity"
            android:exported="false" />

    </application>
</manifest>
