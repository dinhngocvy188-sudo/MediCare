<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Cấp quyền Internet cho Firebase -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MediCare">

        <!-- Activity khởi chạy chính -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- KHAI BÁO ĐẦY ĐỦ CÁC ACTIVITY NÀY -->
        <activity android:name="ui.auth.LoginActivity" />
        <activity android:name="ui.admin.AdminDashboardActivity" />
        <activity android:name="ui.doctor.DoctorDashboardActivity" />
        <!-- Các màn hình đặt lịch khám của TV3 -->
        <activity android:name="ui.appointment.SelectDateActivity" />
        <activity android:name="ui.appointment.SelectTimeActivity" />
        <activity android:name="ui.appointment.ConfirmAppointmentActivity" />
        <activity android:name="ui.appointment.MyAppointmentsActivity" />
        <activity
            android:name="ui.patient.PatientHomeActivity" />

    </application>
</manifest>
